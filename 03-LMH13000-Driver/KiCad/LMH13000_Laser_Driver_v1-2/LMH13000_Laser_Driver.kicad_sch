	(text "Here, a mosfet inverts and switches the PD pin\nSo rather than PD being low by default and therefore \nthe laser being ON, it is pulled high by a pullup resistor, \nso it is off. And switched low when a high signal is applied \nto the mosfet gate, alowing the laser to turn ON."
		(exclude_from_sim no)
		(at 221.488 118.618 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "dd093a15-b097-43af-8ce1-460187b492c0")
	)
